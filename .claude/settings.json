{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(EMULATOR=true:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python3 scripts/render_plugin.py:*)",
      "Bash(python3 update_registry.py:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(sudo:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/check_arch_violations.sh",
            "statusMessage": "Checking architecture violations..."
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/auto_format.sh",
            "statusMessage": "Auto-formatting with ruff..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/check_arch_violations.sh",
            "statusMessage": "Checking architecture violations..."
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/auto_format.sh",
            "statusMessage": "Auto-formatting with ruff..."
          }
        ]
      }
    ]
  }
}
